# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_TOKEN=your_bot_token_here

# ============================================
# Google Gemini API
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# S3 Configuration
# ============================================
BUCKET_NAME=my-app-bucket
BUCKET_URL=https://bucket-name.s3.eu-central-1.amazonaws.com
S3_KEY=your_s3_key_here

# ============================================
# Storage Configuration
# ============================================
S3_SYNC_INTERVAL_MINUTES=1
MESSAGES_META=messages_meta_here
TICKETS_META=tickets_meta_here

# ============================================
# User Configuration
# ============================================
# Support team IDs (comma-separated)
SUPPORT_IDS=12345,67890
# Duty team IDs (comma-separated)
DUTY_IDS=user1,user2

# ============================================
# Scheduling Configuration
# ============================================
# Reminder interval in seconds
REMINDER_INTERVAL=3000

# ============================================
# Webhook Configuration (if applicable)
# ============================================
# WEBHOOK_URL=your_webhook_url
# WEBHOOK_PORT=8443
USE_WEBHOOK=1 if using webhook, otherwise 0
WEBHOOK_URL=https://yourbot.company.com
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443
WEBHOOK_HOST=0.0.0.0
WEBHOOK_SSL_CERT=some_cert.pem or empty if not using SSL
WEBHOOK_SSL_KEY=some_key.pem or empty if not using SSL
HEALTH_PORT=8080
